// Prisma schema VisualMath AI
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ---------- Enums (mengikuti src/lib/types.ts) ----------
 */
enum Role {
  mahasiswa
  dosen
  admin
}

enum Difficulty {
  mudah
  sedang
  sulit
}

enum QuestionType {
  numeric
  choice
  truefalse
}

enum MaterialType {
  materi
  soal
}

enum ActivityKind {
  formula
  quiz
  lesson
  auth
  graph
  system
}

enum LogSeverity {
  info
  warning
  error
}

/**
 * ---------- Entities ----------
 */
model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  role      Role
  nim       String?
  prodi     String?
  kelasId   String?
  kelas     Kelas?   @relation("KelasMembers", fields: [kelasId], references: [id])
  color     String
  createdAt DateTime @default(now())

  taughtClasses Kelas[]         @relation("KelasDosen")
  progress      Progress[]
  history       HistoryRecord[]
  logs          ActivityLog[]
  materials     MaterialItem[]  @relation("MaterialAuthor")
  formulas      FormulaRecord[]
  passwordResets PasswordResetToken[]
  sessions      Session[]
  notifications Notification[]
  certificates  Certificate[]
  questionAttempts QuestionAttempt[]
}

model Kelas {
  id        String         @id
  kode      String
  nama      String
  dosenId   String
  dosen     User           @relation("KelasDosen", fields: [dosenId], references: [id])
  mahasiswa User[]         @relation("KelasMembers")
  materials MaterialItem[]
  createdAt DateTime       @default(now())
}

model Topic {
  id            String @id
  slug          String @unique
  title         String
  subtitle      String
  description   String
  icon          String
  color         String
  formulaCount  Int
  questionCount Int
  order         Int

  questions Question[]
  progress  Progress[]
  materials MaterialItem[]
  formulas  FormulaRecord[]
  attempts  QuestionAttempt[]
}

model Question {
  id             String       @id
  topicId        String
  topic          Topic        @relation(fields: [topicId], references: [id])
  difficulty     Difficulty
  type           QuestionType
  prompt         String
  latex          String?
  options        String[]     @default([])
  expectedAnswer String
  explanation    String
  hint           String?
  attempts       QuestionAttempt[]
}

/**
 * Satu jawaban per soal per sesi latihan. Dipakai untuk:
 * - mencegah XP/hint farming (XP hanya sekali per soal per mahasiswa),
 * - menghitung rekap sesi di server (bukan dari body klien),
 * - mengeluarkan soal yang sudah dijawab dari undian berikutnya.
 */
model QuestionAttempt {
  id         String     @id
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  difficulty Difficulty
  correct    Boolean
  xpEarned   Int
  timeMs     Int        @default(0)
  createdAt  DateTime   @default(now())

  @@unique([sessionId, questionId])
  @@index([userId, questionId])
  @@index([userId, sessionId])
}

model Progress {
  userId    String
  topicId   String
  user      User     @relation(fields: [userId], references: [id])
  topic     Topic    @relation(fields: [topicId], references: [id])
  mastery   Int
  attempts  Int
  solved    Int
  xp        Int
  updatedAt DateTime @default(now())

  @@id([userId, topicId])
}

model HistoryRecord {
  id        String       @id
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  kind      ActivityKind
  title     String
  summary   String
  score     Int?
  xp        Int?
  createdAt DateTime     @default(now())
}

model ActivityLog {
  id        String      @id
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  actorName String
  action    String
  target    String
  severity  LogSeverity
  createdAt DateTime    @default(now())
}

model AIConfig {
  id          String   @id
  provider    String   @default("gemini")
  model       String
  temperature Float
  maxTokens       Int
  stepExplain     Boolean
  adaptiveQuiz    Boolean
  graphSimulation Boolean
  systemPrompt    String
  updatedAt       DateTime @default(now())
}

model MaterialItem {
  id         String       @id
  kelasId    String
  kelas      Kelas        @relation(fields: [kelasId], references: [id])
  topicId    String
  topic      Topic        @relation(fields: [topicId], references: [id])
  type       MaterialType
  title      String
  content    String
  difficulty Difficulty?
  createdBy  String
  author     User         @relation("MaterialAuthor", fields: [createdBy], references: [id])
  updatedAt  DateTime     @default(now())
  embedding  Unsupported("vector(768)")?
  chunks     MaterialChunk[]
}

model MaterialChunk {
  id         String       @id
  materialId String
  material   MaterialItem @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ord        Int
  content    String
  createdAt  DateTime     @default(now())
  embedding  Unsupported("vector(768)")?

  @@index([materialId])
}

model FormulaRecord {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expression String
  display    String
  topicId    String?
  topic      Topic?   @relation(fields: [topicId], references: [id])
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/** Log hit untuk rate limiter sliding-window lintas-instance. */
model RateLimitHit {
  id        String   @id
  bucket    String
  key       String
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
}

/** Sesi login yang dapat dicabut (revocable) — token JWT menunjuk baris ini via jti. */
model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum NotificationKind {
  info
  success
  warning
  error
}

/** Notifikasi in-app untuk pengguna. */
model Notification {
  id        String           @id
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(info)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

/** Sertifikat pencapaian setelah menuntaskan kuis adaptif. */
model Certificate {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String
  topicTitle  String
  score       Int
  xp          Int
  recipientName String
  identity    String?
  code        String   @unique
  issuedAt    DateTime @default(now())

  @@index([userId])
}
