# Variebel lingkungan VisualMath AI — contoh.
# Salin ke .env.local dan isi sesuai nilai kamu. Jangan pernah commit .env* ke git.

# --- Rahasia server (hanya dibaca di sisi server / route handler) ---
# JWT/Session secret. GANTI dengan nilai acak panjang saat produksi.
#   Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=visualmath-ai-dev-session-secret-ganti-di-produksi

# --- Variabel publik (awali NEXT_PUBLIC_ agar aman terekspos ke browser) ---
# Dipakai klien; hanya data non-rahasia.
NEXT_PUBLIC_APP_NAME=VisualMath AI
NEXT_PUBLIC_API_BASE=/api

# --- Opsional: integrasi eksternal (AI/LLM). Jaga kerahasiaan di server. ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=