# Variebel lingkungan VisualMath AI — contoh.
# Salin ke .env.local dan isi sesuai nilai kamu. Jangan pernah commit .env* ke git.

# --- Rahasia server (hanya dibaca di sisi server / route handler) ---
# JWT/Session secret. GANTI dengan nilai acak panjang saat produksi.
#   Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=visualmath-ai-dev-session-secret-ganti-di-produksi

# --- Database (PostgreSQL 17 + pgvector) ---
# Dipakai aplikasi & Prisma CLI. Catatan: `prisma7.config.ts` hanya membaca file `.env`,
# sedangkan Next.js & script backfill membaca `.env` + `.env.local`.
# Jalankan `docker compose up -d` untuk database lokal (user/pass/db = visualmath).
DATABASE_URL=postgresql://visualmath:visualmath@localhost:5432/visualmath?schema=public

# --- Variabel publik (awali NEXT_PUBLIC_ agar aman terekspos ke browser) ---
# Dipakai klien; hanya data non-rahasia.
NEXT_PUBLIC_APP_NAME=VisualMath AI
NEXT_PUBLIC_API_BASE=/api

# --- Integrasi AI (LLM/vision/embedding). Jaga kerahasiaan di server. ---
# Google Gemini — untuk OCR (vision) + embedding RAG, dan bisa juga untuk teks.
#   WAJIB bila memakai fitur OCR/embedding. Ambil gratis di https://aistudio.google.com/apikey
# Jika kosong, aplikasi tetap berjalan memakai mesin matematika lokal (tanpa LLM).
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq — provider TEKS alternatif (explainer, hint, pembahasan) dengan free tier lega.
#   Ambil gratis di https://console.groq.com/keys
# Provider & model dipilih di panel Admin: /admin/konfigurasi (tersimpan di tabel AIConfig).
GROQ_API_KEY=
# Fallback bila kolom provider di DB belum diisi ("gemini" atau "groq"; default: gemini).
# AI_TEXT_PROVIDER=gemini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=